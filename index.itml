                <!-- GitHub Profile Card -->
                <div class="p-6 rounded-3xl bg-white/75 dark:bg-slate-900/60 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-sm flex flex-col justify-between space-y-5">
