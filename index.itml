<!DOCTYPE html>
<html lang="lo" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio | ນ. ວິມາລາ ສານຸວົງ (Vimala Sanouvong)</title>
    
    <!-- Google Fonts: Noto Sans Lao & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Lao:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans Lao"', '"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    animation: {
                        'blob': 'blob 10s infinite',
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        blob: {
                            '0%, 100%': { transform: 'translate(0px, 0px) scale(1)' },
                            '33%': { transform: 'translate(30px, -40px) scale(1.08)' },
                            '66%': { transform: 'translate(-20px, 20px) scale(0.95)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-[#070913] dark:text-slate-100 transition-colors duration-300 antialiased selection:bg-indigo-500 selection:text-white overflow-x-hidden">

    <!-- Animated Gradient Mesh Background -->
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
        <div class="absolute top-[-10%] left-[-10%] w-[28rem] h-[28rem] rounded-full bg-indigo-500/20 dark:bg-indigo-600/20 blur-3xl animate-blob"></div>
        <div class="absolute top-[25%] right-[-8%] w-[26rem] h-[26rem] rounded-full bg-violet-500/20 dark:bg-violet-600/20 blur-3xl animate-blob" style="animation-delay: 2s;"></div>
        <div class="absolute bottom-[-10%] left-[20%] w-[30rem] h-[30rem] rounded-full bg-cyan-500/20 dark:bg-cyan-500/15 blur-3xl animate-blob" style="animation-delay: 4s;"></div>
    </div>

    <!-- Sticky Glass Navigation Bar -->
    <header class="sticky top-0 z-50 backdrop-blur-xl bg-white/75 dark:bg-[#0b0f1e]/75 border-b border-slate-200/70 dark:border-slate-800/70 transition-colors">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Brand Logo -->
                <a href="#home" class="flex items-center gap-3 group">
                    <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-indigo-600 via-violet-600 to-cyan-500 flex items-center justify-center text-white font-extrabold text-lg shadow-lg shadow-indigo-500/30 group-hover:scale-105 transition-transform">
                        ວ
                    </div>
                    <div class="flex flex-col">
                        <span class="font-bold text-base sm:text-lg tracking-tight bg-gradient-to-r from-indigo-600 via-violet-600 to-cyan-500 dark:from-indigo-400 dark:via-violet-400 dark:to-cyan-400 bg-clip-text text-transparent">
                            Vimala.KTVC
                        </span>
                        <span class="text-[11px] text-slate-500 dark:text-slate-400 -mt-1 hidden sm:block">Web Design Portfolio</span>
                    </div>
                </a>

                <!-- Desktop Navigation Links -->
                <nav class="hidden md:flex items-center gap-1.5">
                    <a href="#home" class="px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50/80 dark:text-slate-300 dark:hover:text-cyan-400 dark:hover:bg-slate-800/60 transition-all">
                        ໜ້າຫຼັກ
                    </a>
                    <a href="#about" class="px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50/80 dark:text-slate-300 dark:hover:text-cyan-400 dark:hover:bg-slate-800/60 transition-all">
                        ຂໍ້ມູນສ່ວນຕົວ
                    </a>
                    <a href="#education-skills" class="px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50/80 dark:text-slate-300 dark:hover:text-cyan-400 dark:hover:bg-slate-800/60 transition-all">
                        ການສຶກສາ & ຄວາມສາມາດ
                    </a>
                    <a href="#contact" class="px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50/80 dark:text-slate-300 dark:hover:text-cyan-400 dark:hover:bg-slate-800/60 transition-all">
                        ຕິດຕໍ່
                    </a>
                </nav>

                <!-- Theme Toggle & Mobile Menu Button -->
                <div class="flex items-center gap-2.5">
                    <button id="theme-toggle" aria-label="ສະຫຼັບໂໝດມືດ/ແຈ້ງ" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800/80 dark:hover:bg-slate-700 text-slate-700 dark:text-amber-400 flex items-center justify-center border border-slate-200/70 dark:border-slate-700/70 transition-all">
                        <i class="fa-solid fa-moon dark:hidden text-base"></i>
                        <i class="fa-solid fa-sun hidden dark:inline text-base"></i>
                    </button>
                    
                    <button id="mobile-menu-btn" aria-label="ເປີດເມນູ" class="md:hidden w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800/80 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 flex items-center justify-center border border-slate-200/70 dark:border-slate-700/70 transition-all">
                        <i class="fa-solid fa-bars text-base"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Dropdown Menu -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200/70 dark:border-slate-800/70 bg-white/95 dark:bg-[#0b0f1e]/95 backdrop-blur-xl px-4 pt-2 pb-4 space-y-1">
            <a href="#home" class="mobile-link block px-4 py-3 rounded-xl text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 dark:text-slate-200 dark:hover:bg-slate-800/70">
                <i class="fa-solid fa-house w-5 text-indigo-500"></i> ໜ້າຫຼັກ
            </a>
            <a href="#about" class="mobile-link block px-4 py-3 rounded-xl text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 dark:text-slate-200 dark:hover:bg-slate-800/70">
                <i class="fa-solid fa-user w-5 text-violet-500"></i> ຂໍ້ມູນສ່ວນຕົວ
            </a>
            <a href="#education-skills" class="mobile-link block px-4 py-3 rounded-xl text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 dark:text-slate-200 dark:hover:bg-slate-800/70">
                <i class="fa-solid fa-graduation-cap w-5 text-cyan-500"></i> ການສຶກສາ & ຄວາມສາມາດ
            </a>
            <a href="#contact" class="mobile-link block px-4 py-3 rounded-xl text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 dark:text-slate-200 dark:hover:bg-slate-800/70">
                <i class="fa-solid fa-paper-plane w-5 text-emerald-500"></i> ຕິດຕໍ່
            </a>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- ==================== 1. HERO SECTION ==================== -->
        <section id="home" class="pt-12 pb-16 sm:pt-20 sm:pb-24">
            <div class="flex flex-col-reverse lg:flex-row items-center justify-between gap-12 lg:gap-16">
                
                <!-- Left Content -->
                <div class="flex-1 text-center lg:text-left space-y-6">
                    <!-- Welcome Badge -->
                    <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-indigo-500/10 dark:bg-indigo-500/15 border border-indigo-500/25 text-indigo-600 dark:text-cyan-300 text-xs sm:text-sm font-semibold">
                        <span class="relative flex h-2.5 w-2.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-indigo-600 dark:bg-cyan-400"></span>
                        </span>
                        ຍິນດີຕ້ອນຮັບສູ່ Portfolio ຂອງຂ້ອຍ
                    </div>

                    <!-- Full Name & Subtitle -->
                    <div class="space-y-3">
                        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
                            ນ. ວິມາລາ <span class="bg-gradient-to-r from-indigo-500 via-violet-500 to-cyan-400 bg-clip-text text-transparent">ສານຸວົງ</span>
                        </h1>
                        <p class="text-sm sm:text-base font-medium tracking-wide text-slate-500 dark:text-slate-400 uppercase">
                            Vimala Sanouvong
                        </p>
                        <p class="text-base sm:text-xl font-semibold text-slate-700 dark:text-slate-200 pt-1 leading-relaxed">
                            <i class="fa-solid fa-code text-indigo-500 dark:text-cyan-400 mr-1.5"></i>
                            ພາກວິຊາ ໄອທີ (IT) • ແຂວງຄຳມ່ວນ
                        </p>
                    </div>

                    <!-- Personal Motto Banner -->
                    <div class="max-w-md mx-auto lg:mx-0 p-4 rounded-2xl bg-white/70 dark:bg-slate-900/60 backdrop-blur-md border border-slate-200/80 dark:border-slate-800/80 shadow-sm flex items-center justify-center lg:justify-start gap-4">
                        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-400 to-orange-500 text-white flex items-center justify-center shrink-0 shadow-md shadow-amber-500/20">
                            <i class="fa-solid fa-fire text-lg"></i>
                        </div>
                        <div class="text-left">
                            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-400 block">ຄຳຄົມປະຈຳຕົວ</span>
                            <p class="text-lg sm:text-xl font-extrabold bg-gradient-to-r from-amber-500 to-orange-500 dark:from-amber-300 dark:to-orange-400 bg-clip-text text-transparent">
                                “ ສູ້ຕໍ່ໄປ ”
                            </p>
                        </div>
                    </div>

                    <!-- Quick Action Buttons -->
                    <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-2">
                        <a href="#contact" class="px-6 py-3.5 rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-semibold shadow-lg shadow-indigo-600/30 hover:shadow-indigo-600/45 transition-all flex items-center gap-2.5">
                            <i class="fa-solid fa-paper-plane"></i>
                            ຕິດຕໍ່ຂ້ອຍ
                        </a>
                        <a href="#about" class="px-6 py-3.5 rounded-2xl bg-white/80 dark:bg-slate-900/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-100 font-semibold border border-slate-200/90 dark:border-slate-800 backdrop-blur-md shadow-sm transition-all flex items-center gap-2.5">
                            <i class="fa-solid fa-id-card text-indigo-500 dark:text-cyan-400"></i>
                            ຂໍ້ມູນສ່ວນຕົວ
                        </a>
                    </div>
                </div>

                <!-- Right Profile Card with Glowing Frame & Live Upload Preview -->
                <div class="flex-shrink-0 flex flex-col items-center">
                    <div class="relative p-5 rounded-3xl bg-white/70 dark:bg-slate-900/60 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xl animate-float">
                        <!-- Ambient Glow Behind Frame -->
                        <div class="absolute -inset-1 rounded-3xl bg-gradient-to-tr from-indigo-500 via-violet-500 to-cyan-400 opacity-30 blur-xl -z-10"></div>
                        
                        <!-- Rounded-Square Glowing Profile Frame -->
                        <div class="relative w-60 h-60 sm:w-72 sm:h-72 rounded-2xl p-1.5 bg-gradient-to-tr from-indigo-500 via-violet-500 to-cyan-400 shadow-lg overflow-hidden">
                            <div class="w-full h-full rounded-xl overflow-hidden bg-slate-900 relative">
                                <!-- 
                                    Default image loads ./profile.jpg for GitHub Pages.
                                    Fallback inline SVG avatar renders cleanly if profile.jpg is not present yet.
                                -->
                                <img 
                                    id="profile-preview" 
                                    src="./profile.jpg" 
                                    alt="ຮູບໂປຣໄຟລ໌ ນ. ວິມາລາ ສານຸວົງ"
                                    class="w-full h-full object-cover"
                                    onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 400'><defs><linearGradient id='bg' x1='0%' y1='0%' x2='100%' y2='100%'><stop offset='0%' stop-color='%231e1b4b'/><stop offset='50%' stop-color='%23312e81'/><stop offset='100%' stop-color='%230e7490'/></linearGradient><linearGradient id='shirt' x1='0%' y1='0%' x2='100%' y2='0%'><stop offset='0%' stop-color='%236366f1'/><stop offset='100%' stop-color='%2306b6d4'/></linearGradient></defs><rect width='400' height='400' fill='url(%23bg)'/><circle cx='200' cy='155' r='85' fill='%231e293b'/><path d='M115 160 C115 90, 285 90, 285 160 L295 270 C295 280, 105 280, 105 270 Z' fill='%230f172a'/><path d='M100 370 C100 295, 300 295, 300 370 L310 400 L90 400 Z' fill='url(%23shirt)'/><rect x='182' y='225' width='36' height='45' rx='16' fill='%23fed7aa'/><circle cx='200' cy='175' r='58' fill='%23ffedd5'/><path d='M142 165 C145 110, 255 110, 258 165 C240 135, 195 130, 175 152 C160 138, 148 150, 142 165 Z' fill='%230f172a'/><circle cx='180' cy='175' r='5.5' fill='%231e293b'/><circle cx='220' cy='175' r='5.5' fill='%231e293b'/><circle cx='182' cy='173' r='2' fill='%23ffffff'/><circle cx='222' cy='173' r='2' fill='%23ffffff'/><path d='M188 198 Q200 210 212 198' stroke='%23e11d48' stroke-width='4' fill='none' stroke-linecap='round'/><circle cx='165' cy='188' r='8' fill='%23fda4af' opacity='0.6'/><circle cx='235' cy='188' r='8' fill='%23fda4af' opacity='0.6'/><rect x='135' y='315' width='130' height='75' rx='10' fill='%23cbd5e1'/><circle cx='200' cy='352' r='10' fill='%236366f1'/></svg>`);"
                                >
                            </div>
                        </div>

                        <!-- Interactive Profile Photo Preview Button -->
                        <div class="mt-4 flex flex-col items-center gap-1.5">
                            <label for="profile-upload" class="w-full py-2.5 px-4 rounded-xl bg-indigo-600/10 hover:bg-indigo-600/20 dark:bg-cyan-500/15 dark:hover:bg-cyan-500/25 border border-indigo-500/30 dark:border-cyan-400/30 text-indigo-700 dark:text-cyan-300 text-xs sm:text-sm font-semibold cursor-pointer transition-all flex items-center justify-center gap-2">
                                <i class="fa-solid fa-camera"></i>
                                <span>ທົດລອງອັບໂຫຼດຮູບ (Preview Photo)</span>
                                <input type="file" id="profile-upload" accept="image/*" class="hidden">
                            </label>
                            <span class="text-[11px] text-slate-500 dark:text-slate-400">
                                ຮອງຮັບໄຟລ໌ <code class="text-indigo-600 dark:text-cyan-400 font-mono">profile.jpg</code> ເທິງ GitHub
                            </span>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- ==================== 2. BENTO GRID: PERSONAL INFO & EDUCATION ==================== -->
        <section id="about" class="py-12 sm:py-16">
            <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
                <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-indigo-600 dark:text-cyan-400">About & Profile</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">ຂໍ້ມູນສ່ວນຕົວ & ການສຶກສາ</h2>
                <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400">ລາຍລະອຽດປະຫວັດສ່ວນຕົວ, ການສຶກສາ ແລະ ຄວາມສົນໃຈຂອງຂ້ອຍ</p>
            </div>

            <!-- Bento Grid Layout -->
            <div id="education-skills" class="grid grid-cols-1 md:grid-cols-6 gap-6">
                
                <!-- Card 1: ຂໍ້ມູນສ່ວນຕົວ (Personal Bio) - Span 3 cols -->
                <div class="md:col-span-3 p-7 rounded-3xl bg-white/75 dark:bg-slate-900/60 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-indigo-500/40 dark:hover:border-cyan-400/40 transition-all flex flex-col justify-between space-y-6">
                    <div class="flex items-center gap-3.5">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xl shrink-0">
                            <i class="fa-solid fa-user-astronaut"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white">ຂໍ້ມູນສ່ວນຕົວ</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Personal Biography</p>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="p-3.5 rounded-2xl bg-slate-100/70 dark:bg-slate-800/50 border border-slate-200/50 dark:border-slate-700/50 flex items-center gap-3.5">
                            <i class="fa-solid fa-signature text-indigo-500 dark:text-cyan-400 w-5 text-center"></i>
                            <div>
                                <span class="text-xs text-slate-500 dark:text-slate-400 block">ຊື່ ແລະ ນາມສະກຸນ</span>
                                <span class="font-bold text-slate-900 dark:text-white">ນ. ວິມາລາ ສານຸວົງ</span>
                            </div>
                        </div>

                        <div class="p-3.5 rounded-2xl bg-slate-100/70 dark:bg-slate-800/50 border border-slate-200/50 dark:border-slate-700/50 flex items-center gap-3.5">
                            <i class="fa-solid fa-cake-candles text-violet-500 w-5 text-center"></i>
                            <div>
                                <span class="text-xs text-slate-500 dark:text-slate-400 block">ວັນເດືອນປີເກີດ</span>
                                <span class="font-bold text-slate-900 dark:text-white">9 / 3 / 2009</span>
                            </div>
                        </div>

                        <div class="p-3.5 rounded-2xl bg-slate-100/70 dark:bg-slate-800/50 border border-slate-200/50 dark:border-slate-700/50 flex items-center gap-3.5">
                            <i class="fa-solid fa-location-dot text-rose-500 w-5 text-center"></i>
                            <div>
                                <span class="text-xs text-slate-500 dark:text-slate-400 block">ທີ່ຢູ່ປັດຈຸບັນ</span>
                                <span class="font-bold text-slate-900 dark:text-white">ບ້ານ ແຕນ, ເມືອງ ມະຫາໄຊ, ແຂວງ ຄຳມ່ວນ</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 2: ການສຶກສາ (Education) - Span 3 cols -->
                <div class="md:col-span-3 p-7 rounded-3xl bg-white/75 dark:bg-slate-900/60 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:border-cyan-500/40 transition-all flex flex-col justify-between space-y-6">
                    <div class="flex items-center gap-3.5">
                        <div class="w-12 h-12 rounded-2xl bg-cyan-500/15 text-cyan-600 dark:text-cyan-400 flex items-center justify-center text-xl shrink-0">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white">ພາກວິຊາ & ການຮຽນ</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Department & Academic Focus</p>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="p-4 rounded-2xl bg-gradient-to-br from-indigo-500/10 to-cyan-500/10 border border-indigo-500/20 dark:border-cyan-400/20">
                            <div class="flex items-start gap-3.5">
                                <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center shrink-0 mt-0.5">
                                    <i class="fa-solid fa-laptop-code"></i>
                                </div>
                                <div>
                                    <span class="text-xs font-semibold text-indigo-600 dark:text-cyan-400 uppercase tracking-wider">ພາກວິຊາ</span>
                                    <h4 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mt-0.5 leading-snug">
                                        ພາກວິຊາ ໄອທີ (Information Technology)
                                    </h4>
                                </div>
                            </div>
                        </div>

                        <div class="p-4 rounded-2xl bg-slate-100/70 dark:bg-slate-800/50 border border-slate-200/50 dark:border-slate-700/50">
                            <div class="flex items-start gap-3.5">
                                <div class="w-10 h-10 rounded-xl bg-violet-600 text-white flex items-center justify-center shrink-0 mt-0.5">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                </div>
                                <div>
