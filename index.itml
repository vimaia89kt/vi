    <!-- ==================== FOOTER ==================== -->
    <footer class="border-t border-slate-200/80 dark:border-slate-800/80 py-8 px-4 mt-8">
        <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-medium">
                © 2026 ນ. ວິມາລາ ສານຸວົງ (Vimala Sanouvong) • ພາກວິຊາ ໄອທີ (IT)
            </p>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-slate-600 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-cyan-400 transition-colors">
                <i class="fa-brands fa-github text-base"></i>
                <span>Hosted on GitHub Pages</span>
            </a>
        </div>
    </footer>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="px-4 py-3 rounded-2xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs sm:text-sm font-bold shadow-2xl flex items-center gap-2.5 border border-slate-700 dark:border-slate-200">
            <i class="fa-solid fa-circle-check text-emerald-400 dark:text-emerald-600 text-base"></i>
            <span id="toast-msg">ສຳເລັດ!</span>
        </div>
    </div>

    <!-- JavaScript -->
    <script>
        // Toast Notification Helper
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-msg');
            toastMsg.textContent = message;
            toast.classList.remove('translate-y-24', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3000);
        }

        // Copy to Clipboard Helper (iFrame & browser safe)
        function copyText(text, successMsg) {
            const tempInput = document.createElement('input');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            showToast(successMsg);
        }

        // Dark / Light Theme Toggle (Defaults to Dark Mode)
        const themeToggleBtn = document.getElementById('theme-toggle');
        const htmlEl = document.documentElement;

        if (localStorage.getItem('vimala_theme') === 'light') {
            htmlEl.classList.remove('dark');
        } else {
            htmlEl.classList.add('dark');
        }

        themeToggleBtn.addEventListener('click', () => {
            htmlEl.classList.toggle('dark');
            const isDark = htmlEl.classList.contains('dark');
            localStorage.setItem('vimala_theme', isDark ? 'dark' : 'light');
        });

        // Mobile Navigation Menu Toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Live Profile Image Preview via FileReader
        const profileUpload = document.getElementById('profile-upload');
        const profilePreview = document.getElementById('profile-preview');

        profileUpload.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    profilePreview.src = event.target.result;
                    showToast('ອັບໂຫຼດຮູບໂປຣໄຟລ໌ຕົວຢ່າງສຳເລັດ!');
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
</body>
</html><!DOCTYPE html>
<html lang="lo" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio | ນ. ວິມາລາ ສານຸວົງ (Vimala Sanouvong)</title>
    
    <!-- Google Fonts: Noto Sans Lao & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Lao:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans Lao"', '"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    animation: {
                        'blob': 'blob 10s infinite',
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        blob: {
                            '0%, 100%': { transform: 'translate(0px, 0px) scale(1)' },
                            '33%': { transform: 'translate(30px, -40px) scale(1.08)' },
                            '66%': { transform: 'translate(-20px, 20px) scale(0.95)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-[#070913] dark:text-slate-100 transition-colors duration-300 antialiased selection:bg-indigo-500 selection:text-white overflow-x-hidden">

    <!-- Animated Gradient Mesh Background -->
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
        <div class="absolute top-[-10%] left-[-10%] w-[28rem] h-[28rem] rounded-full bg-indigo-500/20 dark:bg-indigo-600/20 blur-3xl animate-blob"></div>
        <div class="absolute top-[25%] right-[-8%] w-[26rem] h-[26rem] rounded-full bg-violet-500/20 dark:bg-violet-600/20 blur-3xl animate-blob" style="animation-delay: 2s;"></div>
        <div class="absolute bottom-[-10%] left-[20%] w-[30rem] h-[30rem] rounded-full bg-cyan-500/20 dark:bg-cyan-500/15 blur-3xl animate-blob" style="animation-delay: 4s;"></div>
    </div>

    <!-- Sticky Glass Navigation Bar -->
