                            <h3 class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white mt-0.5 truncate" title="visanouvong52@gmail.com">visanouvong52@gmail.com</h3>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 pt-1">
                        <a href="mailto:visanouvong52@gmail.com" class="flex-1 py-2.5 px-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold text-center transition-colors">
